# k-admin-new local config
# Copy to `.env.local` (gitignored) and set a real password.
# Never commit secrets.

# UI
VITE_PORT=15173

# k-data-new HTTP API. Vite / docker proxy `/v1` to this origin.
K_DATA_API_BASE_URL=http://127.0.0.1:28080

# Optional: let the browser call the API directly (requires CORS on k-data-new).
# Leave unset to use the same-origin `/v1` proxy (recommended).
# VITE_API_BASE_URL=http://127.0.0.1:28080

# Single local admin (hashed at runtime with scrypt). No GitHub OAuth.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
